{
  "model_name": "phase2_xtts",
  "run_name": "phase2_xtts_v1",
  "run_description": "Phase 2 Enhanced XTTS with Mamba, MoE, Flash Attention, and RoPE",
  
  "// Model Architecture": "Core model configuration",
  "sample_rate": 22050,
  "mel_channels": 80,
  "fft_size": 1024,
  "hop_length": 256,
  "win_length": 1024,
  "mel_fmin": 0,
  "mel_fmax": 8000,
  
  "// Phase 2 GPT Configuration": "Enhanced GPT with Phase 2 architectures",
  "gpt_batch_size": 1,
  "gpt_max_audio_tokens": 605,
  "gpt_max_text_tokens": 402,
  "gpt_max_prompt_tokens": 70,
  "gpt_layers": 30,
  "gpt_n_model_channels": 1024,
  "gpt_n_heads": 16,
  "gpt_num_audio_tokens": 8194,
  "gpt_start_audio_token": 8192,
  "gpt_stop_audio_token": 8193,
  "gpt_code_stride_len": 1024,
  "gpt_use_masking_gt_prompt_approach": true,
  "gpt_use_perceiver_resampler": false,
  
  "// Phase 2 Enhancements": "Advanced architectural features",
  "use_phase2_enhancements": true,
  "phase2_config": {
    "d_model": 1024,
    "num_heads": 16,
    "num_layers": 30,
    
    "// Mamba/SSM Configuration": "State Space Models for O(n) complexity",
    "use_mamba": true,
    "mamba_d_state": 16,
    "mamba_d_conv": 4,
    "mamba_expand": 2,
    "mamba_dt_rank": "auto",
    "mamba_dt_min": 0.001,
    "mamba_dt_max": 0.1,
    "mamba_dt_init": "random",
    "mamba_dt_scale": 1.0,
    "mamba_dt_init_floor": 1e-4,
    "mamba_conv_bias": true,
    "mamba_bias": false,
    "mamba_use_fast_path": true,
    
    "// Mixture of Experts Configuration": "MoE for 5-10x capacity scaling",
    "use_moe": true,
    "moe_num_experts": 8,
    "moe_top_k": 2,
    "moe_capacity_factor": 1.25,
    "moe_eval_capacity_factor": 2.0,
    "moe_min_capacity": 4,
    "moe_drop_tokens": true,
    "moe_use_residual": false,
    "moe_expert_choice": false,
    "moe_normalize_gate_prob_before_dropping": false,
    "moe_batch_prioritized_routing": false,
    "moe_aux_loss_alpha": 0.01,
    "moe_z_loss_alpha": 0.001,
    
    "// Flash Attention Configuration": "Memory-efficient attention",
    "use_flash_attention": true,
    "flash_attention_causal": true,
    "flash_attention_local": false,
    "flash_attention_local_window_size": 256,
    "flash_attention_alibi": false,
    "flash_attention_deterministic": false,
    "flash_attention_return_softmax": false,
    
    "// RoPE Configuration": "Rotary Position Embedding",
    "use_rope": true,
    "rope_max_position_embeddings": 8192,
    "rope_base": 10000,
    "rope_type": "linear",
    "rope_scaling_factor": 1.0,
    "rope_original_max_position_embeddings": 2048,
    
    "// Integration Settings": "How components work together",
    "attention_dropout": 0.1,
    "hidden_dropout": 0.1,
    "layer_norm_epsilon": 1e-5,
    "gradient_checkpointing": false
  },
  
  "// Neural Codec Configuration": "Enhanced audio representation",
  "use_neural_codec": true,
  "codec_type": "encodec",
  "codec_hidden_dim": 512,
  "codec_num_quantizers": 8,
  "codec_codebook_size": 1024,
  "codec_bitrate": 6.0,
  "adaptive_bitrate": true,
  
  "// Streaming Configuration": "Real-time inference",
  "enable_streaming": true,
  "streaming_chunk_size": 128,
  "streaming_overlap_size": 32,
  "streaming_context_window": 512,
  "streaming_buffer_size": 4096,
  
  "// Quality Monitoring": "Real-time quality assessment",
  "enable_quality_monitoring": true,
  "quality_threshold": 0.7,
  "adaptive_quality_control": true,
  
  "// Performance Optimization": "Training and inference speed",
  "use_flash_attention": true,
  "gradient_checkpointing": true,
  "mixed_precision": true,
  "compile_model": true,
  
  "// Enhanced Training Features": "Advanced loss functions",
  "use_consistency_loss": true,
  "use_perceptual_loss": true,
  "use_adversarial_training": false,
  
  "// Training Configuration": "Training hyperparameters optimized for Phase 2",
  "batch_size": 4,
  "eval_batch_size": 2,
  "num_workers": 4,
  "learning_rate": 5e-5,
  "weight_decay": 1e-6,
  "gradient_clip_val": 1.0,
  "warmup_steps": 2000,
  "max_steps": 100000,
  
  "// Scheduler Configuration": "Learning rate scheduling",
  "scheduler": "cosine_annealing_warm_restarts",
  "scheduler_T_0": 10000,
  "scheduler_T_mult": 2,
  "scheduler_eta_min": 1e-6,
  
  "// Logging and Checkpointing": "Training monitoring",
  "log_interval": 50,
  "eval_interval": 500,
  "save_interval": 2500,
  "max_checkpoints": 5,
  
  "// HifiGAN Decoder Configuration": "Audio generation",
  "input_sample_rate": 22050,
  "output_sample_rate": 24000,
  "output_hop_length": 256,
  "decoder_input_dim": 1024,
  "d_vector_dim": 512,
  "cond_d_vector_in_each_upsampling_layer": true,
  
  "// Constants": "Fixed parameters",
  "duration_const": 102400,
  
  "// Enhanced Targets": "Performance goals with Phase 2",
  "target_mos": 4.9,
  "target_latency_ms": 80,
  "target_rtf": 0.3,
  "target_speaker_similarity": 0.99,
  
  "// Model Paths": "File locations",
  "model_dir": "./models/",
  "gpt_checkpoint": null,
  "decoder_checkpoint": null,
  
  "// Language Support": "Multilingual configuration",
  "languages": ["en", "es", "fr", "de", "it", "pt", "pl", "tr", "ru", "nl", "cs", "ar", "zh-cn", "ja", "hu", "ko", "hi"],
  "default_language": "en",
  
  "// Voice Cloning": "Speaker adaptation",
  "min_reference_length": 3.0,
  "max_reference_length": 30.0,
  "speaker_embedding_dim": 512,
  
  "// Streaming Quality Control": "Adaptive quality",
  "streaming_quality_levels": {
    "high": {"bitrate": 12.0, "latency_penalty": 1.5},
    "medium": {"bitrate": 6.0, "latency_penalty": 1.0},
    "low": {"bitrate": 3.0, "latency_penalty": 0.7}
  },
  "default_streaming_quality": "medium",
  
  "// Phase 2 Specific Settings": "Advanced configurations",
  "phase2_training_mode": "full",
  "phase2_gradient_accumulation_steps": 8,
  "phase2_use_expert_parallelism": true,
  "phase2_expert_parallel_size": 1,
  "phase2_sequence_parallel_size": 1,
  "phase2_activation_checkpointing_layers": [10, 20, 30],
  
  "// Memory Optimization": "Phase 2 memory management",
  "cpu_offload": false,
  "pin_memory": true,
  "prefetch_factor": 2,
  "persistent_workers": true
}
